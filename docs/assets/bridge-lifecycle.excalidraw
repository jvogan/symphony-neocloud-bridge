  "elements": [
    {
      "type": "text",
      "id": "title",
      "x": 40,
      "y": 25,
      "text": "A cloud run, with a verifiable outcome",
      "fontSize": 34,
      "fontFamily": 2,
      "strokeColor": "#142b3b",
      "roughness": 0
    },
    {
      "type": "text",
      "id": "sub",
      "x": 40,
      "y": 80,
      "text": "Plan locally. Authorize execution. Validate outputs and close resources.",
      "fontSize": 21,
      "fontFamily": 2,
      "strokeColor": "#536b7d",
      "roughness": 0
    },
    {
      "type": "rectangle",
      "id": "box0",
      "x": 40,
      "y": 155,
      "width": 370,
      "height": 170,
      "backgroundColor": "#f0f4f8",
      "strokeColor": "#cbd5df",
      "strokeWidth": 1,
      "fillStyle": "solid",
      "roughness": 0,
      "roundness": {
        "type": 3
      }
    },
    {
      "type": "text",
      "id": "head0",
      "x": 64,
      "y": 179,
      "text": "01  Define the contract",
      "fontSize": 25,
      "fontFamily": 2,
      "strokeColor": "#142b3b",
      "roughness": 0
    },
    {
      "type": "text",
      "id": "body0",
      "x": 64,
      "y": 232,
      "text": "Provider and exact workload\nBudget, deadlines, and outputs",
      "fontSize": 21,
      "fontFamily": 2,
      "strokeColor": "#395468",
      "roughness": 0
    },
    {
      "type": "rectangle",
      "id": "box1",
      "x": 470,
      "y": 155,
      "width": 370,
      "height": 170,
      "backgroundColor": "#f0f4f8",
      "strokeColor": "#cbd5df",
      "strokeWidth": 1,
      "fillStyle": "solid",
      "roughness": 0,
      "roundness": {
        "type": 3
      }
    },
    {
      "type": "text",
      "id": "head1",
      "x": 494,
      "y": 179,
      "text": "02  Check and prepare",
      "fontSize": 25,
      "fontFamily": 2,
      "strokeColor": "#142b3b",
      "roughness": 0
    },
    {
      "type": "text",
      "id": "body1",
      "x": 494,
      "y": 232,
      "text": "Self-check and local preflight\nRequest or handoff packet",
      "fontSize": 21,
      "fontFamily": 2,
      "strokeColor": "#395468",
      "roughness": 0
    },
    {
      "type": "rectangle",
      "id": "box2",
      "x": 900,
      "y": 155,
      "width": 370,
      "height": 170,
      "backgroundColor": "#eaf2ff",
      "strokeColor": "#cbd5df",
      "strokeWidth": 1,
      "fillStyle": "solid",
      "roughness": 0,
      "roundness": {
        "type": 3
      }
    },
    {
      "type": "text",
      "id": "head2",
      "x": 924,
      "y": 179,
      "text": "03  Launch once",
      "fontSize": 25,
      "fontFamily": 2,
      "strokeColor": "#142b3b",
      "roughness": 0
    },
    {
      "type": "text",
      "id": "body2",
      "x": 924,
      "y": 232,
      "text": "Explicit authorization\nRecord the provider resource ID",
      "fontSize": 21,
      "fontFamily": 2,
      "strokeColor": "#395468",
      "roughness": 0
    },
    {
      "type": "rectangle",
      "id": "box3",
      "x": 900,
      "y": 400,
      "width": 370,
      "height": 170,
      "backgroundColor": "#eaf2ff",
      "strokeColor": "#cbd5df",
      "strokeWidth": 1,
      "fillStyle": "solid",
      "roughness": 0,
      "roundness": {
        "type": 3
      }
    },
    {
      "type": "text",
      "id": "head3",
      "x": 924,
      "y": 424,
      "text": "04  Observe the workload",
      "fontSize": 25,
      "fontFamily": 2,
      "strokeColor": "#142b3b",
      "roughness": 0
    },
    {
      "type": "text",
      "id": "body3",
      "x": 924,
      "y": 477,
      "text": "Provider state and progress\nDeadline, cancellation, recovery",
      "fontSize": 21,
      "fontFamily": 2,
      "strokeColor": "#395468",
      "roughness": 0
    },
    {
      "type": "rectangle",
      "id": "box4",
