    {
      "type": "text",
      "id": "head4",
      "x": 494,
      "y": 424,
      "text": "05  Verify artifacts",
      "fontSize": 25,
      "fontFamily": 2,
      "strokeColor": "#142b3b",
      "roughness": 0
    },
    {
      "type": "text",
      "id": "body4",
      "x": 494,
      "y": 477,
      "text": "Retrieve required outputs\nRun validators and hash files",
      "fontSize": 21,
      "fontFamily": 2,
      "strokeColor": "#395468",
      "roughness": 0
    },
    {
      "type": "rectangle",
