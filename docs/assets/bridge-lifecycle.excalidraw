      "id": "head5",
      "x": 64,
      "y": 424,
      "text": "06  Close the run",
      "fontSize": 25,
      "fontFamily": 2,
      "strokeColor": "#142b3b",
      "roughness": 0
    },
    {
      "type": "text",
      "id": "body5",
      "x": 64,
      "y": 477,
      "text": "Verify cleanup or retention\nRecord cost and final outcome",
